# .NET build artifacts
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates

# IDE
.vs/
.vscode/
.idea/

# Test output
TestResults/
*.trx
*.coverage
*.coveragexml

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Local logs
exports/logs/
*.log

# --- exports/ ---
# Generated runs are local artifacts. Only examples/ and .gitkeep are tracked.
exports/**/*
!exports/.gitkeep
!exports/examples/
!exports/examples/**/*
!exports/examples/**/**/*

# STL files: regenerate via CLI (including under examples/)
exports/**/*.stl

# Local run index (machine-specific paths); created on first UI/CLI run
exports/runs_index.json

# Saved parameter variants (local experiments)
projects/**/*.json
!projects/.gitkeep

# Screenshot capture script (optional dev tooling)
scripts/node_modules/
scripts/package-lock.json
