@page "/recent-runs"
@inject WorkbenchAppService Workbench

<PageTitle>Recent Runs</PageTitle>

<div class="wb-page-header">
    <h1>Recent Runs</h1>
    <p class="lead mb-0">
        Each run stores parameters, logs, and result files in a timestamped folder under <code>exports/</code>.
        Use this view to reopen a variant and continue print or test documentation.
    </p>
</div>

@if (Runs.Count == 0)
{
    <div class="alert alert-info">No runs have been recorded yet. Generate from a generator page or the CLI to create the first entry.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Project</th>
                    <th>Generator</th>
                    <th>Variant</th>
                    <th>Status</th>
                    <th>Output</th>
                </tr>
            </thead>
            <tbody>
                @foreach (RunRecord run in Runs)
                {
                    <tr>
                        <td class="text-nowrap">@run.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@run.ProjectName</td>
                        <td>@run.GeneratorName</td>
                        <td><code class="small">@run.VariantName</code></td>
                        <td>
                            <span class="badge @(run.Success ? "bg-success" : "bg-danger")">@(run.Success ? "Success" : "Failed")</span>
                        </td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary" href="@($"run-output?outputDirectory={Uri.EscapeDataString(run.OutputDirectory)}")">Open run</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    IReadOnlyList<RunRecord> Runs = [];

    protected override void OnInitialized()
    {
        Runs = Workbench.RecentRuns();
    }
}
