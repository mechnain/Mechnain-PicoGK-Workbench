@page "/generators"
@inject WorkbenchAppService Workbench

<PageTitle>Generator Library</PageTitle>

<div class="wb-page-header">
    <h1>Generator Library</h1>
    <p class="lead mb-0">
        Reusable PicoGK geometry generators. Each entry defines parameters, required measurements, and export types for repeatable mechanical variants.
    </p>
</div>

<div class="row g-3">
    @foreach (GeneratorManifest generator in Workbench.ListGenerators())
    {
        <div class="col-md-6 col-xl-4">
            <div class="card wb-generator-card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <h2 class="card-title mb-0">@generator.Name</h2>
                        <span class="wb-difficulty">@generator.Difficulty</span>
                    </div>
                    <div class="wb-category mb-2">@generator.Category</div>
                    <p class="flex-grow-1">@generator.Description</p>
                    @if (generator.RequiredMeasurements.Count > 0)
                    {
                        <p class="small text-muted mb-3">
                            <strong>Required measurements:</strong>
                            @string.Join(" · ", generator.RequiredMeasurements)
                        </p>
                    }
                    <a class="btn btn-primary mt-auto align-self-start" href="@($"generators/{generator.Id}")">Open generator</a>
                </div>
            </div>
        </div>
    }
</div>
